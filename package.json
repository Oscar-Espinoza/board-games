{
  "name": "board-games",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "build": "bun run --filter @board-games/web build && bun build apps/server/src/index.ts --target=bun --external=socket.io --external=sirv --outfile=apps/server/dist/index.js",
    "start": "bun apps/server/dist/index.js",
    "check": "bun run --filter @board-games/web check && bun --bun tsc --noEmit",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "lab:codenames": "bun packages/jev-lab/src/codenames/run.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "games/*"
  ]
}
